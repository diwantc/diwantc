# Copy to .env for local overrides. Never commit real secrets.

# true = show draft and in-review lessons (Cloudflare Pages preview builds).
# The live site must keep this false or unset.
SHOW_DRAFTS=false

# Optional: read lessons from another folder (used by npm run dev:demo).
# LESSONS_DIR=tests/fixtures/lessons

# --- "Found a mistake?" form (docs/error-reports.md) ---

# Build time. The Turnstile site key is public; it is written into the page.
# Without it, the report page shows the GitHub link instead of the form.
# Local work: Cloudflare's test site key, which always passes.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Pages Function secrets. In production, set them in Cloudflare Pages →
# Settings → Variables and Secrets (encrypted). For a local
# `wrangler pages dev`, put them in .dev.vars (git-ignored), not here.
# TURNSTILE_SECRET_KEY=
# GITHUB_ISSUES_TOKEN=
# Optional, owner/name. Defaults to diwantc/diwantc.
# GITHUB_REPO=
# Not a variable: bind a KV namespace as REPORT_RATE_LIMIT.
